<?xml version="1.0" encoding="utf-8"?>
<!-- Round glass button behind a device card action icon -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/aurora_glass" />
            <stroke
                android:width="1dp"
                android:color="@color/aurora_glass_border" />
        </shape>
    </item>
</ripple>
