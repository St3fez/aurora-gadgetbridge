<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- splash screen -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aurora_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/GadgetbridgeThemeAurora.NoActionBar</item>
        <item name="android:statusBarColor">@color/aurora_ink</item>
        <item name="android:navigationBarColor">@color/aurora_ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
